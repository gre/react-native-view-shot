{
  "name": "ViewShotExample",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "react-native start",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:ios:update-snapshots": "UPDATE_SNAPSHOTS=true detox test --configuration ios.sim.debug",
    "test:e2e:android:update-snapshots": "UPDATE_SNAPSHOTS=true detox test --configuration android.emu.debug",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:android": "detox build --configuration android.emu.debug"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@react-navigation/stack": "^7.12.1",
    "@shopify/react-native-skia": "^2.14.0",
    "buffer": "^6.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-video": "^6.19.3",
    "react-native-view-shot": "file:..",
    "react-native-webview": "^13.17.0",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@jest/reporters": "^29.7.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.2.0",
    "detox": "^20.43.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-junit": "^16.0.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
